{
  "realm": "demo",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "reader", "description": "Can read reports" },
      { "name": "editor", "description": "Can read and create reports" },
      { "name": "admin", "description": "Can read, create and delete reports" }
    ]
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Reader",
      "email": "alice@example.test",
      "credentials": [{ "type": "password", "value": "alice123", "temporary": false }],
      "realmRoles": ["reader"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Editor",
      "email": "bob@example.test",
      "credentials": [{ "type": "password", "value": "bob123", "temporary": false }],
      "realmRoles": ["editor"]
    },
    {
      "username": "carol",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Admin",
      "email": "carol@example.test",
      "credentials": [{ "type": "password", "value": "carol123", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "service-account-demo-service",
      "enabled": true,
      "serviceAccountClientId": "demo-service",
      "realmRoles": ["reader"]
    }
  ],
  "clients": [
    {
      "clientId": "demo-app",
      "name": "Demo user-facing app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8080/*", "http://localhost:3000/*"],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "audience-demo-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "demo-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "demo-service",
      "name": "Demo backend service (service-to-service)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "demo-service-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-demo-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "demo-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
